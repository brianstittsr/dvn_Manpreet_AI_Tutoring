# Environment Configuration
# Copy this file to .env.local and fill in your values

# Node Environment
NODE_ENV=development

# ============================================================================
# SUPABASE CONFIGURATION (EasyPanel)
# ============================================================================
# Get these values from your EasyPanel Supabase instance

# Supabase API Configuration
# Access your Supabase dashboard via EasyPanel and go to Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-easypanel-domain.com/supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Database Direct Connection (for migrations and server-side operations)
# Format: postgresql://postgres:password@host:port/database
# Internal (if deploying within EasyPanel): postgresql://postgres:password@supabasevp-db:5432/postgres
# External (if running locally): postgresql://postgres:password@your-domain.com:5432/postgres
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@supabasevp-db:5432/postgres

# ============================================================================
# LEGACY FIREBASE CONFIGURATION (Optional - for migration)
# ============================================================================
# Keep these if you're migrating from Firebase, otherwise can be removed
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ============================================================================
# STRIPE PAYMENT CONFIGURATION
# ============================================================================
# Get these from https://dashboard.stripe.com/apikeys
# Test keys start with sk_test_ and pk_test_
# Production keys start with sk_live_ and pk_live_

# Stripe Secret Key (Server-side only)
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Stripe Publishable Key (Client-side safe)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Webhook Secret (from https://dashboard.stripe.com/webhooks)
# Used to verify webhook signatures
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ============================================================================
# INTEGRATIONS
# ============================================================================

# UserWay Accessibility Widget
# Get your account ID from https://userway.org/dashboard
NEXT_PUBLIC_USERWAY_ACCOUNT_ID=

# ============================================================================
# SMTP EMAIL CONFIGURATION
# ============================================================================

# Legacy 83 Business Email (Office 365)
CURIOQUEST_SMTP_HOST=smtp.office365.com
CURIOQUEST_SMTP_PORT=587
CURIOQUEST_SMTP_SECURE=false
CURIOQUEST_SMTP_USER=info@curioquest.com
CURIOQUEST_SMTP_PASSWORD=your-email-password-here

# Gmail (App Password)
# Step 1: Enable 2-Step Verification on your Google Account:
#   https://myaccount.google.com/security
# Step 2: Generate an App Password (16-char code, no spaces):
#   https://myaccount.google.com/apppasswords
#   Select "Mail" as the app and "Other" as the device, then copy the code.
# Step 3: Paste the code (without spaces) as GMAIL_APP_PASSWORD below.
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_SMTP_SECURE=false
GMAIL_SMTP_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Which email provider to use for booking notifications: "gmail" | "resend"
EMAIL_PROVIDER=gmail

# Sender address shown in outgoing emails (must match GMAIL_SMTP_USER when using Gmail)
EMAIL_FROM=your-gmail-address@gmail.com

# ============================================================================
# RESEND EMAIL SERVICE (alternative to Gmail SMTP)
# ============================================================================
# Sign up for free at https://resend.com — 3,000 emails/month on the free tier.
# Step 1: Verify your sending domain in the Resend dashboard.
# Step 2: Create an API key under API Keys > Create API Key.
# Step 3: Paste the key below (starts with re_).
RESEND_API_KEY=re_your_api_key_here
# From address — must use a domain you have verified in Resend
RESEND_FROM_EMAIL=bookings@curioquest.com

# ============================================================================
# GOOGLE CALENDAR INTEGRATION
# ============================================================================
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ============================================================================
# MICROSOFT / OFFICE 365 CALENDAR INTEGRATION
# ============================================================================
# Register app at: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_TENANT_ID=common

# ============================================================================
# APP URL (for OAuth callbacks)
# ============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================================
# NOTES
# ============================================================================
# NEXT_PUBLIC_* variables are exposed to the browser
# Variables without NEXT_PUBLIC_ prefix are server-side only
# Never commit .env.local to version control

OPENAI_API_KEY=your-api-key
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://xxxx.ngrok.io/v1
LLM_MODEL=default

# ============================================================================
# IMAGE SEARCH APIs (for Hero Carousel Management)
# ============================================================================

# Pexels API
# Get your free API key at: https://www.pexels.com/api/
# Free tier: 200 requests/hour
PEXELS_API_KEY=your-pexels-api-key-here

# Unsplash API
# Get your access key at: https://unsplash.com/developers
# Free tier: 50 requests/hour
UNSPLASH_ACCESS_KEY=your-unsplash-access-key-here
# ============================================================================
# REA WEB CLONER (local-only admin tool)
# ============================================================================
# The REA Web Cloner admin module runs the local REA CLI (github.com/morluto/rea)
# on the machine serving this app. It only works on a host where REA is
# installed — e.g. `npm run dev` on your machine, never on Vercel.

# Path to the cloned rea repository root
REA_HOME=C:\Users\Buyer\Documents\CascadeProjects\rea

# Optional: explicit Chrome/Chromium executable for browser scenarios.
# Defaults to the newest installed Playwright chromium under %LOCALAPPDATA%\ms-playwright.
# REA_CHROMIUM_PATH=C:\Users\Buyer\AppData\Local\ms-playwright\chromium-1228\chrome-win64\chrome.exe

# Optional: where capture Evidence and environment bundles are written.
# Defaults to <home>\rea-captures
# REA_OUTPUT_DIR=C:\Users\Buyer\rea-captures
