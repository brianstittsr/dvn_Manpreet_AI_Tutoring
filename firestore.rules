rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }
    
    function isTeamMember() {
      return isAuthenticated() && getUserRole() in ['admin', 'team'];
    }
    
    function isAffiliate() {
      return isAuthenticated() && getUserRole() == 'affiliate';
    }
    
    function isOrgMember(orgId) {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organizationId == orgId;
    }

    // Users collection - authenticated portal users only
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Organizations collection - authenticated portal users only
    match /organizations/{orgId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();

      // Certifications subcollection
      match /certifications/{certId} {
        allow read, write: if isAuthenticated();
      }

      // Capabilities subcollection
      match /capabilities/{capId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Opportunities - public lead forms can create; portal reads/writes
    match /opportunities/{oppId} {
      allow read: if isAuthenticated();
      allow create: if true;
      allow update, delete: if isAuthenticated();
    }

    // Projects collection - authenticated portal users only
    match /projects/{projectId} {
      allow read, create, update, delete: if isAuthenticated();

      // Milestones subcollection
      match /milestones/{milestoneId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Meetings collection - authenticated portal users only
    match /meetings/{meetingId} {
      allow read, create, update, delete: if isAuthenticated();

      // Action items subcollection
      match /actionItems/{actionId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Action Items collection (top-level) - authenticated portal users only
    match /actionItems/{actionId} {
      allow read, create, update, delete: if isAuthenticated();
    }

    // Documents collection - authenticated portal users only
    match /documents/{docId} {
      allow read, create, update, delete: if isAuthenticated();
    }

    // Services collection
    match /services/{serviceId} {
      allow read: if true; // Public read for marketing
      allow write: if isAuthenticated();
    }

    // Activities collection - authenticated portal users only
    match /activities/{activityId} {
      allow read, create, update, delete: if isAuthenticated();
    }

    // Notes collection - authenticated portal users only
    match /notes/{noteId} {
      allow read, create, update, delete: if isAuthenticated();
    }

    // =========================================================================
    // Affiliate Networking System Collections
    // =========================================================================

    // Affiliate Biographies - affiliates can manage their own
    match /affiliateBiographies/{bioId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.affiliateId == request.auth.uid;
      allow update: if resource.data.affiliateId == request.auth.uid || isAdmin();
      allow delete: if isAuthenticated();
    }

    // GAINS Profiles - affiliates can manage their own
    match /gainsProfiles/{profileId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.affiliateId == request.auth.uid;
      allow update: if resource.data.affiliateId == request.auth.uid || isAdmin();
      allow delete: if isAuthenticated();
    }

    // Contact Spheres - affiliates can manage their own
    match /contactSpheres/{sphereId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.affiliateId == request.auth.uid;
      allow update: if resource.data.affiliateId == request.auth.uid || isAdmin();
      allow delete: if isAuthenticated();
    }

    // Previous Customers - affiliates can manage their own
    match /previousCustomers/{customersId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.affiliateId == request.auth.uid;
      allow update: if resource.data.affiliateId == request.auth.uid || isAdmin();
      allow delete: if isAuthenticated();
    }

    // One-to-One Meetings - participants can read/update
    match /oneToOneMeetings/{meetingId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.initiatorId == request.auth.uid ||
        resource.data.partnerId == request.auth.uid
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        isAdmin() ||
        resource.data.initiatorId == request.auth.uid ||
        resource.data.partnerId == request.auth.uid
      );
      allow delete: if isAuthenticated();
    }

    // Referrals - referrer and recipient can access
    match /referrals/{referralId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.referrerId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        isAdmin() ||
        resource.data.referrerId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid
      );
      allow delete: if isAuthenticated();
    }

    // Affiliate Stats - affiliates can read their own, admins can read all
    match /affiliateStats/{statsId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.affiliateId == request.auth.uid
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated(); // Stats are updated by system/admin
      allow delete: if isAuthenticated();
    }

    // AI Match Suggestions - affiliates can read their own suggestions
    match /aiMatchSuggestions/{suggestionId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.affiliateId == request.auth.uid
      );
      allow create: if isAuthenticated(); // Only system creates suggestions
      allow update: if isAuthenticated() && (
        isAdmin() ||
        resource.data.affiliateId == request.auth.uid // Can accept/decline
      );
      allow delete: if isAuthenticated();
    }

    // =========================================================================
    // Strategic Partners
    // =========================================================================

    // Strategic Partners - authenticated portal users only
    match /strategicPartners/{partnerId} {
      allow read, create, update, delete: if isAuthenticated();
    }

    // Team Members - public read for the marketing "leadership team" section;
    // writes require a signed-in account
    match /teamMembers/{memberId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }

    // Platform Settings - authenticated users only; secrets are stored separately
    match /platformSettings/{settingsId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
      
      // Notifications subcollection
      match /notifications/{notificationId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }
      
      // Allow any other subcollections
      match /{subcollection}/{docId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }
    }

    // Server-only secrets (including the platform LLM API key)
    match /platformSecrets/{settingsId} {
      allow read: if false;
      allow write: if false;
    }

    // =========================================================================
    // Apollo Integration Collections
    // =========================================================================

    // Apollo Purchased Contacts - authenticated portal users only
    match /apolloPurchasedContacts/{contactId} {
      allow read, create, update, delete: if isAuthenticated();
    }

    // Apollo Saved Lists - authenticated portal users only
    match /apolloSavedLists/{listId} {
      allow read, create, update, delete: if isAuthenticated();
    }

    // =========================================================================
    // =========================================================================
    // Software License Keys
    // =========================================================================

    // Software Keys - admin only for management
    match /softwareKeys/{keyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Key Activations - track key usage
    match /keyActivations/{activationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // =========================================================================
    // White-Label Deployments
    // =========================================================================

    // White-Label Deployments - admin management
    match /whiteLabelDeployments/{deploymentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Deployment Analytics
    match /deploymentAnalytics/{analyticsId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Deployment Audit Logs
    match /deploymentAuditLogs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if false;
      allow delete: if false;
    }

    // =========================================================================
    // Calendar & Scheduling Collections
    // =========================================================================

    // Calendar Events - portal manages; public booking flow can create
    match /calendarEvents/{eventId} {
      allow read: if isAuthenticated();
      allow create: if true;
      allow update, delete: if isAuthenticated();
    }

    // 1-to-1 Scheduling Queue - authenticated portal users only
    match /oneToOneQueue/{queueId} {
      allow read, create, update, delete: if isAuthenticated();
    }

    // Team Member Availability - public read so visitors can book;
    // only signed-in staff can change availability
    match /teamMemberAvailability/{availabilityId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Bookings - public can create a booking; staff manage them
    match /bookings/{bookingId} {
      allow read: if isAuthenticated();
      allow create: if true;
      allow update, delete: if isAuthenticated();
    }

    // =========================================================================
    // Legacy 83 Academy LMS Collections
    // =========================================================================

    // Subscription Tiers - public read, admin write
    match /subscriptionTiers/{tierId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // User Subscriptions - users can read their own
    match /userSubscriptions/{subscriptionId} {
      allow read: if isAuthenticated() && (
        isAdmin() || resource.data.userId == request.auth.uid
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Course Categories - public read, admin write
    match /courseCategories/{categoryId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Courses - public read for published, admin write
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAuthenticated();

      // Course Modules subcollection
      match /modules/{moduleId} {
        allow read: if true;
        allow write: if isAuthenticated();

        // Lessons subcollection
        match /lessons/{lessonId} {
          allow read: if true;
          allow write: if isAuthenticated();
        }
      }
    }

    // Course Enrollments - users can manage their own
    match /courseEnrollments/{enrollmentId} {
      allow read: if isAuthenticated() && (
        isAdmin() || resource.data.userId == request.auth.uid
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
        isAdmin() || resource.data.userId == request.auth.uid
      );
      allow delete: if isAuthenticated();
    }

    // Lesson Progress - users can manage their own
    match /lessonProgress/{progressId} {
      allow read: if isAuthenticated() && (
        isAdmin() || resource.data.userId == request.auth.uid
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated();
    }

    // Assessments - public read for published, admin write
    match /assessments/{assessmentId} {
      allow read: if true;
      allow write: if isAuthenticated();

      // Assessment Questions subcollection
      match /questions/{questionId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }
    }

    // Assessment Attempts - users can manage their own
    match /assessmentAttempts/{attemptId} {
      allow read: if isAuthenticated() && (
        isAdmin() || resource.data.userId == request.auth.uid
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated();
    }

    // Workshops - public read for published, admin write
    match /workshops/{workshopId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Workshop Registrations - users can manage their own
    match /workshopRegistrations/{registrationId} {
      allow read: if isAuthenticated() && (
        isAdmin() || resource.data.userId == request.auth.uid
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
        isAdmin() || resource.data.userId == request.auth.uid
      );
      allow delete: if isAuthenticated();
    }

    // Learning Paths - public read for published, admin write
    match /learningPaths/{pathId} {
      allow read: if true;
      allow write: if isAuthenticated();

      // Learning Path Items subcollection
      match /items/{itemId} {
        allow read: if true;
        allow write: if isAuthenticated();
      }
    }

    // User Learning Path Progress - users can manage their own
    match /userLearningPaths/{progressId} {
      allow read: if isAuthenticated() && (
        isAdmin() || resource.data.userId == request.auth.uid
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated();
    }

    // Certificates - users can read their own, public verification
    match /certificates/{certificateId} {
      allow read: if true; // Public for verification
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // User Performance Metrics - users can read their own
    match /userPerformanceMetrics/{metricId} {
      allow read: if isAuthenticated() && (
        isAdmin() || resource.data.userId == request.auth.uid
      );
      allow write: if isAuthenticated(); // System-generated
    }

    // Discussion Threads - authenticated users can participate
    match /discussionThreads/{threadId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        isAdmin() || resource.data.userId == request.auth.uid
      );
      allow delete: if isAuthenticated();

      // Discussion Replies subcollection
      match /replies/{replyId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update: if isAuthenticated() && (
          isAdmin() || resource.data.userId == request.auth.uid
        );
        allow delete: if isAuthenticated();
      }
    }

    // Quiz Leads - for Legacy Growth IQ Quiz submissions
    match /quizLeads/{leadId} {
      allow read: if isAuthenticated();
      allow create: if true; // Public can submit quiz
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Quiz Results - users can read their own
    match /quizResults/{resultId} {
      allow read: if true; // Public for sharing results
      allow create: if true; // Public can submit quiz
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Quiz Submissions - public can submit; staff/admin review authenticated
    match /quizSubmissions/{submissionId} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated();
    }

    // =========================================================================
    // Public-facing collections (anonymous site visitors)
    // =========================================================================

    // Marketing events - public read for event pages
    match /events/{eventId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Event registrations - confirmation page reads without sign-in;
    // server routes manage writes via the Admin SDK
    match /eventRegistrations/{registrationId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAuthenticated();
    }

    // Hero slides - public read for homepage carousel
    match /heroSlides/{slideId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Success stories - public read for marketing pages
    match /successStories/{storyId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Book-a-call leads - public can submit contact form
    match /bookCallLeads/{leadId} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated();
    }

    // Bug tracker items - public can submit bug reports
    match /bugTrackerItems/{itemId} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated();
    }

    // SMS opt-ins - public can submit opt-in forms
    match /smsOptIns/{optInId} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated();
    }

    // =========================================================================
    // Proposals & CRM Collections
    // =========================================================================

    // Proposals - team members can manage
    match /proposals/{proposalId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Proposal Templates - admin managed
    match /proposalTemplates/{templateId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Blog Posts - public read, admin write
    match /blogPosts/{postId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Blog Categories - public read, admin write
    match /blogCategories/{categoryId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // =========================================================================
    // AI Workforce Collections (migrated from localStorage)
    // =========================================================================

    // AI Employees - users can manage their own
    match /aiEmployees/{employeeId} {
      allow read: if isAuthenticated() && (
        isAdmin() || resource.data.userId == request.auth.uid
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // AI Chats - users can manage their own chat histories
    match /aiChats/{chatId} {
      allow read: if isAuthenticated() && (
        isAdmin() || resource.data.userId == request.auth.uid
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // User Settings - users can manage their own settings
    match /userSettings/{settingsId} {
      allow read, create, update, delete: if isAuthenticated();
    }

    // =========================================================================
    // AI-Guided LMS Collections
    // Sensitive GPT lesson data is server-only; clients use the API routes.
    // =========================================================================
    match /lms_gpt_lesson_sessions/{sessionId} {
      allow read: if false;
      allow write: if false;
      match /events/{eventId} {
        allow read: if false;
        allow write: if false;
      }
    }

    match /lms_gpt_lesson_assessments/{assessmentId} {
      allow read: if false;
      allow write: if false;
    }

    match /lms_gpt_lesson_scores/{scoreId} {
      allow read: if false;
      allow write: if false;
    }

    match /lms_gpt_guardian_links/{linkId} {
      allow read: if false;
      allow write: if false;
    }

    match /lms_gpt_safety_incidents/{incidentId} {
      allow read: if false;
      allow write: if false;
    }

    match /lms_interview_sessions/{sessionId} {
      allow read: if false;
      allow write: if false;
      match /turns/{turnId} {
        allow read: if false;
        allow write: if false;
      }
    }

    match /lms_learner_profiles/{profileId} {
      allow read: if false;
      allow write: if false;
    }

    // Public LMS catalog metadata. Learner progress and operational records still
    // require authentication through the authenticated fallback below.
    match /lms_categories/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /lms_courses/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /lms_course_modules/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /lms_lessons/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /lms_workshops/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /lms_badges/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /lms_subscription_tiers/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /lms_learning_paths/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /lms_settings/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // =========================================================================
    // AUTHENTICATED FALLBACK
    // Collections not explicitly listed above are available only to signed-in
    // clients. Sensitive GPT and secrets collections are intentionally excluded.
    // =========================================================================
    match /{collection}/{document=**} {
      allow read: if isAuthenticated() && !(collection in [
        'lms_gpt_lesson_sessions',
        'lms_gpt_lesson_assessments',
        'lms_gpt_lesson_scores',
        'lms_gpt_guardian_links',
        'lms_gpt_safety_incidents',
        'lms_interview_sessions',
        'lms_learner_profiles',
        'platformSecrets'
      ]);
      allow write: if isAuthenticated() && !(collection in [
        'lms_gpt_lesson_sessions',
        'lms_gpt_lesson_assessments',
        'lms_gpt_lesson_scores',
        'lms_gpt_guardian_links',
        'lms_gpt_safety_incidents',
        'lms_interview_sessions',
        'lms_learner_profiles',
        'platformSecrets'
      ]);
    }
  }
}
